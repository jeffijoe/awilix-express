{
  "name": "awilix-express",
  "version": "0.0.0-development",
  "description": "Awilix helpers for Express",
  "main": "lib/index.js",
  "typings": "lib/index.d.ts",
  "exports": {
    ".": {
      "import": "./lib/index.mjs",
      "require": "./lib/index.js",
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    }
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "rimraf lib && tsc -p tsconfig.build.json && rollup -c",
    "test": "node tools/test.cjs",
    "test:watch": "node tools/test.cjs --watch",
    "lint": "eslint \"src/**/*.ts\" && prettier --check \"src/**/*.ts\"",
    "cover": "c8 node tools/test.cjs",
    "semantic-release": "semantic-release",
    "check": "tsc -p tsconfig.test.json --noEmit"
  },
  "prettier": {
    "semi": false,
    "singleQuote": true
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/jeffijoe/awilix-express.git"
  },
  "files": [
    "lib",
    "LICENSE.md",
    "README.md"
  ],
  "directories": {
    "lib": "lib"
  },
  "keywords": [],
  "author": "Talysson <talyssonoc@gmail.com>, Jeff Hansen <jeffijoe@hotmail.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/jeffijoe/awilix-express/issues"
  },
  "homepage": "https://github.com/jeffijoe/awilix-express",
  "dependencies": {
    "awilix-router-core": "^4.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@rollup/plugin-typescript": "^12.3.1",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "awilix": "^13.0.7",
    "c8": "^12.0.0",
    "eslint": "^10.15.0",
    "express": "^5.3.0",
    "prettier": "^3.10.1",
    "rimraf": "^6.1.4",
    "rollup": "^4.68.8",
    "semantic-release": "^26.0.1",
    "tslib": "^2.9.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.73.0"
  },
  "overrides": {
    "test-exclude": {
      "glob": "14.0.6",
      "minimatch": "11.0.9"
    }
  }
}
