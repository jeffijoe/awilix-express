{
  "exclude": ["node_modules", "lib"],
  "compileOnSave": false,
  "include": ["src/**/*.ts"],
  "compilerOptions": {
    "outDir": "./lib",
    "strict": true,
    "strictNullChecks": true,
    "experimentalDecorators": true,
    "noImplicitAny": true,
    "target": "ES2022",
    "module": "nodenext",
    "esModuleInterop": true,
    "importHelpers": false,
    "sourceMap": true,
    "declaration": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": "./",
    "lib": ["ES2022"]
  }
}
